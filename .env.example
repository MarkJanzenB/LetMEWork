# Get a key at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Optional — used automatically if the primary key hits quota / payment limits
FIRECRAWL_API_KEY_BACKUP=

# Optional model providers (beyond OpenCode free / local Ollama)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — Ollama Cloud (ollama.com). No local ollama serve.
# https://ollama.com/settings/keys
OLLAMA_API_KEY=
